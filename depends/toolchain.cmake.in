# CMake toolchain file for consuming the packages built by depends/.
# Generated from toolchain.cmake.in by depends/Makefile.
#
# Pass it to the first CMake invocation:
#   cmake -B build --toolchain depends/<host>/toolchain.cmake

# Only set CMAKE_SYSTEM_NAME when actually cross-compiling: setting it at all
# makes CMake flip CMAKE_CROSSCOMPILING to TRUE even for a matching host.
if(@depends_crosscompiling@)
  set(CMAKE_SYSTEM_NAME @host_system_name@)
  set(CMAKE_SYSTEM_VERSION @host_system_version@)
  set(CMAKE_SYSTEM_PROCESSOR @host_arch@)

  set(CMAKE_C_COMPILER_TARGET @host@)
  set(CMAKE_CXX_COMPILER_TARGET @host@)
endif()

# cargo's target triple. Not the same string as @host@: depends' rust_target
# maps e.g. x86_64-apple-darwin24.6.0 to x86_64-apple-darwin, which is what
# rustc actually recognises (see depends/packages/native_rust.mk).
set(DEPENDS_RUST_TARGET "@rust_target@")

if(NOT DEFINED CMAKE_C_COMPILER)
  set(CMAKE_C_COMPILER @CC@)
endif()
if(NOT DEFINED CMAKE_CXX_COMPILER)
  set(CMAKE_CXX_COMPILER @CXX@)
endif()

if(NOT DEFINED CMAKE_C_FLAGS_INIT)
  set(CMAKE_C_FLAGS_INIT "@CFLAGS@")
endif()
if(NOT DEFINED CMAKE_CXX_FLAGS_INIT)
  set(CMAKE_CXX_FLAGS_INIT "@CXXFLAGS@")
endif()

# The DEPENDS_COMPILE_DEFINITIONS variable is to be treated as a list.
set(DEPENDS_COMPILE_DEFINITIONS @CPPFLAGS@)

if(NOT DEFINED CMAKE_EXE_LINKER_FLAGS_INIT)
  set(CMAKE_EXE_LINKER_FLAGS_INIT "@LDFLAGS@")
endif()
if(NOT DEFINED CMAKE_SHARED_LINKER_FLAGS_INIT)
  set(CMAKE_SHARED_LINKER_FLAGS_INIT "@LDFLAGS@")
endif()

set(CMAKE_AR "@AR@")
set(CMAKE_RANLIB "@RANLIB@")
set(CMAKE_STRIP "@STRIP@")
set(CMAKE_NM "@NM@")

# Using our own built dependencies should not be affected by a potentially
# random environment.
set(CMAKE_FIND_USE_CMAKE_ENVIRONMENT_PATH OFF)

set(CMAKE_FIND_ROOT_PATH "${CMAKE_CURRENT_LIST_DIR}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(QT_TRANSLATIONS_DIR "${CMAKE_CURRENT_LIST_DIR}/translations")

# Restore the root prefix so find_package() etc. still look under
# CMAKE_FIND_ROOT_PATH on cmake builds that strip "/" (e.g. Nix).
if(NOT "/" IN_LIST CMAKE_PREFIX_PATH)
  list(APPEND CMAKE_PREFIX_PATH "/")
endif()

if(CMAKE_SYSTEM_NAME MATCHES "^(Linux|FreeBSD|OpenBSD)$")
  # Point pkg-config at the depends prefix and make its output suitable for
  # static linking (needed to resolve the xcb QPA platform plugin's deps).
  cmake_path(APPEND CMAKE_CURRENT_LIST_DIR "lib" "pkgconfig" OUTPUT_VARIABLE pkg_config_path)
  set(ENV{PKG_CONFIG_PATH} ${pkg_config_path})
  set(ENV{PKG_CONFIG_LIBDIR} ${pkg_config_path})
  unset(pkg_config_path)
  set(PKG_CONFIG_ARGN --static)
endif()

# Feed the main build system the options implied by which package groups were
# built. depends/Makefile can emit "not-set" as an empty or all-spaces string,
# so match rather than compare.
if("@qt_packages@" MATCHES "^[ ]*$")
  set(BUILD_GUI OFF CACHE BOOL "")
  set(USE_QRCODE OFF CACHE BOOL "")
else()
  set(BUILD_GUI ON CACHE BOOL "")
  set(USE_QRCODE ON CACHE BOOL "")
  set(Qt6_ROOT "${CMAKE_CURRENT_LIST_DIR}" CACHE PATH "")
endif()

if("@wallet_packages@" MATCHES "^[ ]*$")
  set(ENABLE_WALLET OFF CACHE BOOL "")
else()
  set(ENABLE_WALLET ON CACHE BOOL "")
endif()

if("@tor_i2pd_packages@" MATCHES "^[ ]*$")
  set(ENABLE_EMBEDDED_TOR OFF CACHE BOOL "")
  set(ENABLE_EMBEDDED_I2PD OFF CACHE BOOL "")
else()
  set(ENABLE_EMBEDDED_TOR ON CACHE BOOL "")
  set(ENABLE_EMBEDDED_I2PD ON CACHE BOOL "")
endif()
